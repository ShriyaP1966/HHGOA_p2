# Copy to .env for local development. The real .env must never be committed.

# Ethereum Sepolia RPC endpoint (Alchemy or any provider)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key

# Throwaway TESTNET wallet only; never a wallet that holds real funds.
SEPOLIA_PRIVATE_KEY=0xyour_testnet_private_key

# Clients must send this in the X-API-Key header to use save_to_blockchain.
# Leave empty to disable blockchain writes entirely.
API_KEY=change-me-to-a-long-random-string

# Optional overrides
# CONTRACT_ADDRESS=0x39E7cccCA9A0AC85F19Bb1DE7F88D48bA7c5FF19
# WRITE_RATE_LIMIT=5
# WRITE_RATE_WINDOW_SECONDS=60
